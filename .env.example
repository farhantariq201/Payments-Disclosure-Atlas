# SEC requires a User-Agent identifying you, with a contact email. Requests
# without one get rate-limited and then blocked.
SEC_USER_AGENT="Farhan Tariq farhantariq@ucsb.edu"

ANTHROPIC_API_KEY="sk-ant-..."

# Cheap model for the bulk labelling pass, stronger one for chunks where the
# bulk model and the keyword baseline disagree.
PDA_BULK_MODEL="claude-haiku-4-5-20251001"
PDA_ADJUDICATOR_MODEL="claude-sonnet-5"
PDA_BATCH_SIZE=6
